# pc1 and pc2 are in VLAN 10 (sales), pc3 and pc4 in VLAN 20 (eng), joined by a trunk between
# sw1 and sw2. Everything is configured from the consoles.
@sw1
enable
configure terminal
vlan 10
name sales
vlan 20
name eng
exit
interface fa0/1
switchport access vlan 10
exit
interface fa0/2
switchport access vlan 20
exit
interface fa0/8
switchport mode trunk
end
show vlan brief
show interfaces trunk

@sw2
enable
configure terminal
vlan 10
name sales
vlan 20
name eng
exit
interface fa0/1
switchport access vlan 10
exit
interface fa0/2
switchport access vlan 20
exit
interface fa0/8
switchport mode trunk
end
show running-config

@pc1
ipconfig set 10.0.10.1 255.255.255.0
@pc2
ipconfig set 10.0.10.2 255.255.255.0
@pc3
ipconfig set 10.0.20.3 255.255.255.0
@pc4
ipconfig set 10.0.20.4 255.255.255.0

@pc1
ping 10.0.10.2
ping 10.0.20.4
@pc3
ping 10.0.20.4

@sw1
show mac address-table

# Stop VLAN 20 crossing the trunk: VLAN 10 keeps working, VLAN 20 does not.
configure terminal
interface fa0/8
switchport trunk allowed vlan remove 20
end
show interfaces trunk
@pc3
ping 10.0.20.4
@pc1
ping 10.0.10.2
