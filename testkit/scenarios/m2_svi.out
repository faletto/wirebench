== sw1
sw1#configure terminal
sw1(config)#interface fa0/3
sw1(config-if)#ip address 10.9.9.1 255.255.255.0
% Addresses go on VLAN interfaces (interface vlan N), not on switch ports.
sw1(config-if)#interface vlan 20
sw1(config-if)#switchport mode trunk
% switchport commands apply to switch ports, not VLAN interfaces.
sw1(config-if)#no interface vlan 30
% No such interface.
sw1(config-if)#no interface vlan 20
sw1(config-if)#end
sw1#show running-config
hostname sw1
!
vlan 10
!
vlan 20
!
ip routing
!
interface FastEthernet0/1
 switchport access vlan 10
!
interface FastEthernet0/2
 switchport access vlan 20
!
interface Vlan10
 ip address 10.0.10.1 255.255.255.0
 shutdown
!
end
sw1#configure terminal
sw1(config)#no ip routing
sw1(config)#interface vlan 10
sw1(config-if)#no shutdown
sw1(config-if)#ip default-gateway 10.0.10.254
sw1(config-if)#end
sw1#show ip route
Codes: C connected, S static

S  0.0.0.0/0  via 10.0.10.254, Vlan10
C  10.0.10.0/24  directly connected, Vlan10
