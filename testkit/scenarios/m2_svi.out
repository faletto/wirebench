
== sw1
sw1>enable
sw1#configure terminal
sw1(config)#interface fa0/1
sw1(config-if)#switchport access vlan 10
% Access VLAN does not exist. Creating vlan 10
sw1(config-if)#exit
sw1(config)#interface fa0/2
sw1(config-if)#switchport access vlan 20
% Access VLAN does not exist. Creating vlan 20
sw1(config-if)#exit
sw1(config)#interface vlan 10
sw1(config-if)#ip address 10.0.10.1 255.255.255.0
sw1(config-if)#exit
sw1(config)#interface vlan 20
sw1(config-if)#ip address 10.0.20.1 255.255.255.0
sw1(config-if)#end
sw1#show ip interface brief
Interface             Address           Status
Vlan10                10.0.10.1         up
Vlan20                10.0.20.1         up
sw1#show ip route
Codes: C connected, S static

C  10.0.10.0/24  directly connected, Vlan10
C  10.0.20.0/24  directly connected, Vlan20

== pc1
pc1>ipconfig set 10.0.10.2 255.255.255.0
pc1>ipconfig gateway 10.0.10.1

== pc2
pc2>ipconfig set 10.0.20.2 255.255.255.0
pc2>ipconfig gateway 10.0.20.1

