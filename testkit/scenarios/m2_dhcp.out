
== r1
r1>enable
r1#configure terminal
r1(config)#interface g0/0
r1(config-if)#ip address 10.0.1.1 255.255.255.0
r1(config-if)#no shutdown
r1(config-if)#exit
r1(config)#interface g0/1
r1(config-if)#ip address 10.0.12.1 255.255.255.252
r1(config-if)#no shutdown
r1(config-if)#exit
r1(config)#ip route 10.0.2.0 255.255.255.0 10.0.12.2
r1(config)#ip dhcp excluded-address 10.0.1.1 10.0.1.9
r1(config)#ip dhcp excluded-address 10.0.2.1 10.0.2.9
r1(config)#ip dhcp pool lan1
r1(dhcp-config)#network 10.0.1.0 255.255.255.0
r1(dhcp-config)#default-router 10.0.1.1
r1(dhcp-config)#dns-server 8.8.8.8
r1(dhcp-config)#lease 0 8
r1(dhcp-config)#exit
r1(config)#ip dhcp pool lan2
r1(dhcp-config)#network 10.0.2.0 255.255.255.0
r1(dhcp-config)#default-router 10.0.2.1
r1(dhcp-config)#dns-server 8.8.8.8 8.8.4.4
r1(dhcp-config)#end
r1#show ip dhcp pool
Pool lan1 :
 Network          : 10.0.1.0/24
 Addresses in use : 0
 Default router   : 10.0.1.1
 DNS servers      : 8.8.8.8
 Lease            : 0 days 8 hours 0 minutes

Pool lan2 :
 Network          : 10.0.2.0/24
 Addresses in use : 0
 Default router   : 10.0.2.1
 DNS servers      : 8.8.8.8 8.8.4.4
 Lease            : 1 days 0 hours 0 minutes

== r2
r2>enable
r2#configure terminal
r2(config)#interface g0/0
r2(config-if)#ip address 10.0.12.2 255.255.255.252
r2(config-if)#no shutdown
r2(config-if)#exit
r2(config)#interface g0/1
r2(config-if)#ip address 10.0.2.1 255.255.255.0
r2(config-if)#ip helper-address 10.0.12.1
r2(config-if)#no shutdown
r2(config-if)#exit
r2(config)#ip route 10.0.1.0 255.255.255.0 10.0.12.1
r2(config)#end
r2#show running-config
hostname r2
!
interface GigabitEthernet0/0
 ip address 10.0.12.2 255.255.255.252
 no shutdown
!
interface GigabitEthernet0/1
 ip address 10.0.2.1 255.255.255.0
 ip helper-address 10.0.12.1
 no shutdown
!
ip route 10.0.1.0 255.255.255.0 10.0.12.1
end

