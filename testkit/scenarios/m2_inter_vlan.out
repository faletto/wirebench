
== sw1
sw1>enable
sw1#configure terminal
sw1(config)#interface fa0/1
sw1(config-if)#switchport access vlan 10
% Access VLAN does not exist. Creating vlan 10
sw1(config-if)#exit
sw1(config)#interface fa0/2
sw1(config-if)#switchport access vlan 20
% Access VLAN does not exist. Creating vlan 20
sw1(config-if)#exit
sw1(config)#interface fa0/8
sw1(config-if)#switchport mode trunk
sw1(config-if)#end

== r1
r1>enable
r1#configure terminal
r1(config)#interface g0/0.10
r1(config-if)#ip address 10.0.10.1 255.255.255.0
% Set an encapsulation (encapsulation dot1q <vlan>) before addressing a subinterface.
r1(config-if)#encapsulation dot1q 10
r1(config-if)#ip address 10.0.10.1 255.255.255.0
r1(config-if)#exit
r1(config)#interface g0/0.20
r1(config-if)#encapsulation dot1q 20
r1(config-if)#ip address 10.0.20.1 255.255.255.0
r1(config-if)#exit
r1(config)#interface g0/0.30
r1(config-if)#encapsulation dot1q 20
% That VLAN is already used by another subinterface of this port.
r1(config-if)#interface g0/0
r1(config-if)#no shutdown
r1(config-if)#end
r1#show ip interface brief
Interface             Address           Status
GigabitEthernet0/0    unassigned        up
GigabitEthernet0/1    unassigned        admin down
GigabitEthernet0/0.10 10.0.10.1         up
GigabitEthernet0/0.20 10.0.20.1         up
GigabitEthernet0/0.30 unassigned        up
r1#show ip route
Codes: C connected, S static

C  10.0.10.0/24  directly connected, GigabitEthernet0/0.10
C  10.0.20.0/24  directly connected, GigabitEthernet0/0.20
r1#show running-config
hostname r1
!
interface GigabitEthernet0/0
 no ip address
 no shutdown
!
interface GigabitEthernet0/1
 no ip address
 shutdown
!
interface GigabitEthernet0/0.10
 encapsulation dot1q 10
 ip address 10.0.10.1 255.255.255.0
!
interface GigabitEthernet0/0.20
 encapsulation dot1q 20
 ip address 10.0.20.1 255.255.255.0
!
interface GigabitEthernet0/0.30
 no ip address
!
end

