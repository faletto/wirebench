
== r1
r1>enable
r1#configure terminal
r1(config)#router ospf 1
r1(config-router)#router-id 1.1.1.1
r1(config-router)#network 10.1.0.0 0.0.255.255 area 1
r1(config-router)#exit
r1(config)#interface g0/0
r1(config-if)#ip address 10.1.12.1 255.255.255.0
r1(config-if)#no shutdown
r1(config-if)#exit
r1(config)#interface g0/1
r1(config-if)#ip address 10.1.1.1 255.255.255.0
r1(config-if)#no shutdown
r1(config-if)#end

== r2
r2>enable
r2#configure terminal
r2(config)#router ospf 1
r2(config-router)#router-id 2.2.2.2
r2(config-router)#network 10.1.12.0 0.0.0.255 area 1
r2(config-router)#network 10.0.23.0 0.0.0.255 area 0
r2(config-router)#exit
r2(config)#interface g0/0
r2(config-if)#ip address 10.1.12.2 255.255.255.0
r2(config-if)#no shutdown
r2(config-if)#exit
r2(config)#interface g0/1
r2(config-if)#ip address 10.0.23.2 255.255.255.0
r2(config-if)#no shutdown
r2(config-if)#end

== r3
r3>enable
r3#configure terminal
r3(config)#router ospf 1
r3(config-router)#router-id 3.3.3.3
r3(config-router)#network 10.0.0.0 0.0.255.255 area 0
r3(config-router)#default-information originate
r3(config-router)#exit
r3(config)#interface g0/0
r3(config-if)#ip address 10.0.23.3 255.255.255.0
r3(config-if)#no shutdown
r3(config-if)#exit
r3(config)#interface g0/1
r3(config-if)#ip address 10.0.3.1 255.255.255.0
r3(config-if)#no shutdown
r3(config-if)#exit
r3(config)#ip route 0.0.0.0 0.0.0.0 10.0.3.10
r3(config)#end

== pc1
pc1>ipconfig set 10.1.1.10 255.255.255.0
pc1>ipconfig gateway 10.1.1.1

== pc3
pc3>ipconfig set 10.0.3.10 255.255.255.0
pc3>ipconfig gateway 10.0.3.1

-- 100 s pass

