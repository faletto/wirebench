== sw1
sw1#show running-config
hostname sw1
!
cdp run
lldp run
!
interface FastEthernet0/1
 switchport mode access
 no lldp transmit
!
end
sw1#configure terminal
sw1(config)#interface fa0/2
sw1(config-if)#shutdown
sw1(config-if)#end

