
== pc1
C:\>ipconfig set 10.0.0.10 255.255.255.0
C:\>ipconfig gateway 10.0.0.254

== srv
C:\>ipconfig set 10.0.1.10 255.255.255.0
C:\>ipconfig gateway 10.0.1.254

== r1
r1>enable
r1#configure terminal
r1(config)#interface g0/1
r1(config-if)#ip address 10.0.1.1 255.255.255.0
r1(config-if)#standby 1 ip 10.0.1.254
r1(config-if)#standby 1 priority 110
r1(config-if)#standby 1 preempt
r1(config-if)#no shutdown
r1(config-if)#interface g0/0
r1(config-if)#ip address 10.0.0.1 255.255.255.0
r1(config-if)#standby 1 ip 10.0.0.254
r1(config-if)#standby 1 priority 110
r1(config-if)#standby 1 preempt
r1(config-if)#standby 1 track g0/1 20
r1(config-if)#no shutdown
r1(config-if)#end

== r2
r2>enable
r2#configure terminal
r2(config)#interface g0/0
r2(config-if)#ip address 10.0.0.2 255.255.255.0
r2(config-if)#standby 1 ip 10.0.0.254
r2(config-if)#standby 1 preempt
r2(config-if)#no shutdown
r2(config-if)#interface g0/1
r2(config-if)#ip address 10.0.1.2 255.255.255.0
r2(config-if)#standby 1 ip 10.0.1.254
r2(config-if)#no shutdown
r2(config-if)#end
r2#show standby brief
                     P indicates configured to preempt.
                     |
Interface   Grp  Pri P State   Active          Standby         Virtual IP
