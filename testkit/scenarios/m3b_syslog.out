== r1
r1>enable
r1#configure terminal
r1(config)#interface g0/0
r1(config-if)#ip address 10.0.0.1 255.255.255.0
r1(config-if)#no shutdown
r1(config-if)#exit
r1(config)#logging host 10.0.0.10
r1(config)#logging buffered
r1(config)#end

-- 3 s pass

== sw1
